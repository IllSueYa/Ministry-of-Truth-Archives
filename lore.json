 ' "super-earth": {
    "title": "Super Earth",
    "category": "Government",
    "description": "Super Earth is the center of the Federation and the governing power behind the Helldivers, SEAF, and humanity's expansion throughout the galaxy.",
    "source": "https://helldivers.wiki.gg/wiki/Super_Earth",
    "image": ""
  },
  "managed-democracy": {
    "title": "Managed Democracy",
    "category": "Government",
    "description": "Managed Democracy is Super Earth's computerized voting system. Citizens answer questions and an algorithm determines which candidates best represent their choices, which Super Earth presents as eliminating the uncertainty of older democratic systems.",
    "source": "https://helldivers.wiki.gg/wiki/Managed_Democracy",
    "image": ""
  },
  "malevelon-creek": {
    "title": "Malevelon Creek",
    "category": "Planet",
    "description": "Malevelon Creek is an ionic jungle world in the Severin Sector that became one of the most famous battlefields of the Second Galactic War. Early in the war, Helldivers repeatedly fought Automaton forces there despite difficult conditions and limited support.",
    "source": "https://helldivers.wiki.gg/wiki/Malevelon_Creek",
    "image": ""
  },
  "meridia": {
    "title": "Meridia",
    "category": "Planet",
    "description": "Meridia became a Terminid Supercolony after some Terminids adapted to the Termicide used by Super Earth. The planet was eventually destroyed using Dark Fluid, collapsing it into the Meridian Black Hole.",
    "source": "https://helldivers.wiki.gg/wiki/Meridia",
    "image": ""
  },
  "helldivers": {
    "title": "Helldivers",
    "category": "Organization",
    "description": "Helldivers are elite soldiers deployed by Super Earth to conduct high-risk missions across hostile worlds. They are launched from orbit aboard Super Destroyers and are expected to complete objectives under extreme battlefield conditions in service of Managed Democracy.",
    "source": "https://helldivers.wiki.gg/wiki/Helldivers",
    "image": ""
  },
  "seaf": {
    "title": "Super Earth Armed Forces (SEAF)",
    "category": "Organization",
    "description": "The Super Earth Armed Forces, commonly known as SEAF, are the conventional military forces of Super Earth. They defend Federation territory, operate military installations, and fight alongside the Helldivers throughout the Galactic War.",
    "source": "https://helldivers.wiki.gg/wiki/Super_Earth_Armed_Forces",
    "image": ""
  },
  "super-destroyer": {
    "title": "Super Destroyer",
    "category": "Vehicle",
    "description": "The Super Destroyer is the orbital warship assigned to a Helldiver. It serves as a mobile command center and provides orbital support, equipment deployment, reinforcements, and transportation between operations.",
    "source": "https://helldivers.wiki.gg/wiki/Super_Destroyer",
    "image": ""
  },
  "pelican-1": {
    "title": "Pelican-1",
    "category": "Vehicle",
    "description": "Pelican-1 is the extraction shuttle used to retrieve Helldivers from the battlefield after their mission objectives have been completed. The shuttle arrives at designated extraction zones and transports surviving Helldivers back to their Super Destroyer.",
    "source": "https://helldivers.wiki.gg/wiki/Pelican-1",
    "image": ""
  },
  "eagle-1": {
    "title": "Eagle-1",
    "category": "Person",
    "description": "Eagle-1 is the pilot responsible for delivering Eagle-based air support to Helldivers on the battlefield. From the Super Destroyer, Eagle-1 conducts rapid attack runs using weapons selected as Stratagems by the Helldiver.",
    "source": "https://helldivers.wiki.gg/wiki/Eagle-1",
    "image": ""
  },
   "element-710": {
    "title": "Element 710",
    "category": "Technology",
    "description": "Element 710 is a strategically important resource used by Super Earth. Terminids can be processed into Element 710, making the species economically valuable to the Federation despite the enormous threat they pose.",
    "source": "https://helldivers.wiki.gg/wiki/Element_710",
    "image": ""
  },
   "cyberstan": {
    "title": "Cyberstan",
    "category": "Planet",
    "description": "Cyberstan is the historic homeworld of the Cyborgs and a major location in the conflict surrounding the Automatons and Super Earth.",
    "source": "https://helldivers.wiki.gg/wiki/Cyberstan",
    "image": ""
  },
  "democracy-officer": {
    "title": "Democracy Officer",
    "category": "Person",
    "description": "The Democracy Officer serves aboard the Super Destroyer as a representative of Super Earth authority, providing mission guidance and reinforcing the principles of Managed Democracy.",
    "source": "https://helldivers.wiki.gg/wiki/Democracy_Officer",
    "image": ""
  },
  "major-orders": {
    "title": "Major Orders",
    "category": "Galactic War",
    "description": "Major Orders are large-scale strategic objectives issued to the Helldiver community. They can require the liberation or defense of planets, destruction of enemy forces, completion of special operations, or other galaxy-wide objectives within a limited period.",
    "source": "https://helldivers.wiki.gg/wiki/Major_Orders",
    "image": ""
  },
  "first-galactic-war": {
    "title": "First Galactic War",
    "category": "History",
    "description": "The First Galactic War was a roughly forty-year conflict fought by the Super Earth Federation against the Bugs, Cyborgs, and Illuminate. The Helldivers fought across all three fronts, and the war ultimately ended in Super Earth victory. The Bugs were placed into farms for Element 710 production, the defeated Cyborgs were forced to labor on Cyberstan, and the Illuminate were defeated and believed to have been eradicated.",
    "source": "https://helldivers.wiki.gg/wiki/First_Galactic_War",
    "image": ""
  },
  "second-galactic-war": {
    "title": "Second Galactic War",
    "category": "History",
    "description": "The Second Galactic War began around 2184 after approximately a century of relative peace following the First Galactic War. Terminids escaped containment and spread through the eastern sectors while the Automaton Legion emerged in the west, prompting Super Earth to reactivate the Helldivers. The conflict later expanded further with the return of the Illuminate, creating a galaxy-wide war fought across multiple fronts.",
    "source": "https://helldivers.wiki.gg/wiki/Second_Galactic_War",
    "image": ""
  },
  "operation-valiant-enclosure": {
    "title": "Operation Valiant Enclosure",
    "category": "History",
    "description": "Operation Valiant Enclosure was a major Super Earth campaign against the Terminids during the early Second Galactic War. Helldivers fought to secure the Barrier Planets of Erata Prime, Fenrir III, Meridia, and Turing, where the Terminid Control System was constructed and activated. The TCS dispersed Termicide in an attempt to contain the Terminid threat. Although initially declared a success, some Terminids adapted to the chemical, contributing to explosive reproduction and the eventual transformation of Meridia into a Supercolony.",
    "source": "https://helldivers.wiki.gg/wiki/Operation_Valiant_Enclosure",
    "image": ""
  },
  "operation-swift-disassembly": {
    "title": "Operation Swift Disassembly",
    "category": "History",
    "description": "Operation Swift Disassembly was a multi-phase Super Earth offensive intended to completely eradicate the Automatons. Helldivers captured a long-range communications array on Troost, attacked Automaton production centers, defended key worlds against a counterattack, and finally assaulted the remaining Automaton planets of Maia, Tibit, and Durgen. The operation appeared successful when the Automaton vanguard was eliminated, but the victory was short-lived: a much larger Automaton fleet soon invaded during the Reclamation.",
    "source": "https://helldivers.wiki.gg/wiki/Operation_Swift_Disassembly",
    "image": ""
  },
  "the-reclamation": {
    "title": "The Reclamation",
    "category": "History",
    "description": "The Reclamation began on April 9, 2184, only two days after Super Earth believed the Automatons had been eradicated. A massive Automaton invasion fleet arrived from beyond the Galactic Frontier and overwhelmed Super Earth defenses across the Valdis region. The invading force dwarfed the Automaton vanguard destroyed during Operation Swift Disassembly and rapidly captured Cyberstan, revealing that the earlier Automaton armies had represented only a fraction of their true strength.",
    "source": "https://helldivers.wiki.gg/wiki/The_Reclamation",
    "image": ""
  },
  "operation-enduring-peace": {
    "title": "Operation Enduring Peace",
    "category": "History",
    "description": "Operation Enduring Peace was Super Earth's campaign to destroy the Terminid Supercolony on Meridia. Helldivers first secured the surrounding staging worlds before deploying weaponized Dark Fluid into Meridia's crust. Once enough Dark Fluid had been injected, the planet collapsed, destroying the Supercolony and leaving the Meridian Black Hole in its place.",
    "source": "https://helldivers.wiki.gg/wiki/Operation_Enduring_Peace",
    "image": ""
  },
   "meridian-black-hole": {
    "title": "Meridian Black Hole",
    "category": "Galactic Phenomenon",
    "description": "The Meridian Black Hole formed after Helldivers injected Dark Fluid into the Terminid Supercolony on Meridia, causing the planet to collapse on June 2, 2184. Initially believed to be a black hole, later research determined the anomaly was actually a wormhole. Following the return of the Illuminate, the Meridian Singularity became central to their plans: Dark Energy harvested during Illuminate invasions was used to move the anomaly across the galaxy, turning the remains of Meridia into a devastating weapon.",
    "source": "https://helldivers.wiki.gg/wiki/Meridian_Black_Hole",
    "image": ""
  },
  "battle-of-calypso": {
    "title": "Battle of Calypso",
    "category": "History",
    "description": "The Battle of Calypso marked the return of the Illuminate to open warfare after more than a century. Illuminate forces emerged through the Meridian anomaly and launched a surprise invasion of the Super Earth colony on Calypso. The attackers deployed Overseers, Harvesters, and hordes of Voteless created from abducted and transformed human colonists. Helldivers were ordered to Calypso under LIBCON 1 and fought for roughly three days before successfully repelling the invasion.",
    "source": "https://helldivers.wiki.gg/wiki/Calypso",
    "image": ""
  },
  "the-great-host": {
    "title": "The Great Host",
    "category": "History",
    "description": "The Great Host was a massive Illuminate invasion fleet constructed in secret beyond the Meridian Wormhole. After the Meridian Singularity was halted, the fleet emerged and began advancing toward Super Earth, bringing new Illuminate forces including Stingrays, Fleshmobs, Crescent Overseers, Leviathans, and Overships. The Great Host eventually reached the Solar System and launched the Illuminate assault on Super Earth before being destroyed during the Battle for Super Earth.",
    "source": "https://helldivers.wiki.gg/wiki/The_Great_Host",
    "image": ""
  },
  "battle-for-super-earth": {
    "title": "First Battle for Super Earth",
    "category": "History",
    "description": "The First Battle for Super Earth began on May 20, 2185 when the Illuminate Great Host reached humanity's homeworld and assaulted its Mega Cities. Helldivers and SEAF forces fought an eleven-day defense as Eagleopolis, Remembrance, Administrative Center 02, Port Mercy, and York Supreme were destroyed. Despite enormous losses and the death of the President of Super Earth, the defenders reduced the Great Host to a fraction of its original strength. On the final day, the Illuminate withdrew, leaving Prosperity City and Equality-on-Sea standing and Super Earth under Federation control.",
    "source": "https://helldivers.wiki.gg/wiki/Galactic_War/First_Battle_For_Super_Earth",
    "image": ""
  },
  "great-host-remnants": {
    "title": "Remnants of the Great Host",
    "category": "History",
    "description": "After their defeat during the First Battle for Super Earth, the surviving Illuminate forces activated cloaking technology and withdrew from the homeworld. Super Earth scientists later studied captured Illuminate wreckage and developed methods to detect the cloaked enemy. Hidden Illuminate positions were subsequently discovered in the southern galaxy, proving that the defeat of the Great Host had not ended the Illuminate threat.",
    "source": "https://helldivers.wiki.gg/wiki/The_Great_Host",
    "image": ""
  },
   "vessel-00": {
    "title": "Vessel 00",
    "category": "Automaton History",
    "description": "Vessel 00 is a mysterious spacecraft connected to the origins of the Automatons. Intelligence recovered from Database One revealed that the vessel departed Cyberstan in 2180, four years before the beginning of the Second Galactic War. Its destination and cargo records were erased, while Automaton records refer to Vessel 00 as their 'seed' or 'origin,' making it one of the most important clues concerning the true origin of the Automaton Legion.",
    "source": "https://helldivers.wiki.gg/wiki/Automatons",
    "image": ""
  },
  "database-one": {
    "title": "Database One",
    "category": "Automaton Intelligence",
    "description": "Database One was the codename for a massive and heavily encrypted Automaton Data Center located on Wasat. Helldivers fought through Wezen and Vega Bay to reach Wasat and successfully captured the facility in June 2184. The enormous archive revealed information about an Automaton terraforming project on Cyberstan and contained repeated references to several mysterious subjects, including Vessel 00, Nucleus, and The Final Collective. Much of the recovered information remained encrypted and required extensive analysis by Super Earth.",
    "source": "https://helldivers.wiki.gg/wiki/Database_One",
    "image": ""
  },
  "nucleus": {
    "title": "Nucleus",
    "category": "Classified Automaton Intelligence",
    "description": "Nucleus is a mysterious term repeatedly discovered within the encrypted files of Database One. In October 2185, Super Earth located an encryption key on Aesir Pass that could have unlocked the Nucleus files. Helldivers instead secured the competing Vessel 00 encryption key on Menkent, causing the Nucleus data to be lost. The true nature and significance of Nucleus therefore remain unknown.",
    "source": "https://helldivers.wiki.gg/wiki/Database_One",
    "image": ""
  },
  "the-final-collective": {
    "title": "The Final Collective",
    "category": "Classified Automaton Intelligence",
    "description": "The Final Collective is a mysterious term recovered from Database One, the massive Automaton data center captured on Wasat. It appeared repeatedly alongside other classified subjects including Vessel 00 and Nucleus. Unlike Vessel 00, no confirmed intelligence has yet revealed what The Final Collective actually refers to. Its identity, purpose, and significance remain unknown.",
    "source": "https://helldivers.wiki.gg/wiki/Database_One",
    "image": ""
  },
  "jet-brigade": {
    "title": "Jet Brigade",
    "category": "Automaton Division",
    "description": "The Jet Brigade is a specialized Automaton assault division equipped with reverse-engineered jump-pack technology. Designed as a rapid invasion force, the Brigade uses its enhanced mobility to overwhelm planets before moving on to its next target. It first appeared during the Automaton campaign to locate the Democracy Space Station project and has since returned in multiple offensives. Later versions of the Jet Brigade expanded beyond infantry to include jump-pack-equipped Devastators and Hulks.",
    "source": "https://helldivers.wiki.gg/wiki/Jet_Brigade",
    "image": ""
  },
  "democracy-space-station": {
    "title": "Democracy Space Station (DSS)",
    "category": "Super Earth Megastructure",
    "description": "The Democracy Space Station is a massive Super Earth battle station designed to support Helldiver operations across the Galactic War. Its blueprints were recovered from an abandoned First Galactic War weapons laboratory on X-45, and Helldivers later secured Gaellivare as its construction site. Once operational, the DSS became a Helldiver-directed strategic weapon: Helldivers vote on where it deploys and donate resources to activate powerful Tactical Actions that support campaigns on the planet it orbits.",
    "source": "https://helldivers.wiki.gg/wiki/Democracy_Space_Station",
    "image": ""
  },
   "the-gloom": {
    "title": "The Gloom",
    "category": "Galactic Phenomenon",
    "description": "The Gloom is an enormous interstellar cloud of Terminid spores that began emerging from deep Terminid territory in August 2184. The cloud rapidly expanded across multiple planets and sectors, blocking Super Earth from gathering reliable intelligence within its boundaries. Ships and probes entering the Gloom lost communications, while Terminids exposed to its extreme evolutionary conditions developed increasingly dangerous mutations. The Gloom eventually concealed heavily transformed worlds, including Oshaune, which was discovered to have become a Terminid Hive World.",
    "source": "https://helldivers.wiki.gg/wiki/The_Gloom",
    "image": ""
  },
  "operation-righteous-reclamation": {
    "title": "Operation Righteous Reclamation",
    "category": "History",
    "description": "Operation Righteous Reclamation was Super Earth's major offensive into the Gloom. Beginning in August 2185, Helldivers were ordered to penetrate the massive Terminid spore cloud and establish a permanent forward operating base within its perimeter. Hellmire was liberated and Outpost Alpha was established, giving the Helldiver fleet unprecedented access to the interior of the Gloom. From there, spore-flow analysis led Super Earth to Oshaune, a planet transformed by extreme Terminid terraformation into a Hive World. The operation then expanded into reconnaissance, research, and combat operations against the mutated Terminids hidden within the Gloom.",
    "source": "https://helldivers.wiki.gg/wiki/Major_Orders_of_2025",
    "image": ""
  },
  "oshaune": {
    "title": "Oshaune",
    "category": "Planet",
    "description": "Oshaune is a planet in the Mirin Sector and the first Terminid Hive World discovered by Super Earth. After being hidden within the Gloom for more than a year, the planet underwent extreme Terminid terraformation, developing vast subterranean cave networks and Spore Lungs responsible for producing Gloom spores. Helldiver expeditions discovered dangerous new and returning Terminid threats on Oshaune, including the Rupture Strain, Dragonroaches, and Hive Lords. In November 2185, Oshaune was liberated and 99% of its Spore Lungs were destroyed, causing the Gloom to dramatically recede.",
    "source": "https://helldivers.wiki.gg/wiki/Oshaune",
    "image": ""
  },
  "hive-worlds": {
    "title": "Hive Worlds",
    "category": "Terminid Territory",
    "description": "Hive Worlds are planets completely infested and terraformed by the Terminids. Beneath their surfaces lie enormous networks of caves containing Terminid nests, hostile organisms, and Spore Lungs believed to produce and sustain the Gloom. Their surfaces are similarly transformed, featuring Terminid structures, spires, and hazardous environments. Oshaune was the first Hive World discovered by Super Earth, while Zagon Prime and Omicron were subsequently identified as Hive Worlds hidden within the Gloom.",
    "source": "https://helldivers.wiki.gg/wiki/Hive_World",
    "image": ""
  },
   "hive-lord": {
    "title": "Hive Lord",
    "category": "Terminid",
    "description": "Hive Lords are enormous subterranean Terminids and one of the largest known organisms fielded by the Terminid swarm. The strain existed during the First Galactic War but was believed to have gone extinct. Prolonged mutation within the Gloom caused Hive Lords to reappear during the Second Galactic War. They were encountered beneath the Hive World Oshaune, where their massive burrowing bodies could move through the planet's underground networks and erupt onto the battlefield. Large numbers of Hive Lords later participated in the Terminid defense of Oshaune against the Helldiver offensive.",
    "source": "https://helldivers.wiki.gg/wiki/Hive_Lord",
    "image": ""
  },
  "rupture-strain": {
    "title": "Rupture Strain",
    "category": "Terminid Strain",
    "description": "The Rupture Strain is a specialized Terminid subfaction created through mutation within the Gloom. First encountered during Helldiver expeditions into the Hive Worlds, the strain consists of Rupture Warriors, Rupture Spewers, and Rupture Chargers. These Terminids have adapted to subterranean environments and share the ability to burrow underground, rapidly approach their targets, and erupt from beneath the surface to ambush Helldivers. The strain represents one of several dangerous new evolutionary branches produced by the Gloom.",
    "source": "https://helldivers.wiki.gg/wiki/Rupture_Strain",
    "image": ""
  },
  "dragonroach": {
    "title": "Dragonroach",
    "category": "Terminid",
    "description": "The Dragonroach is a massive flying Terminid created through Gloom-induced mutation. First encountered during Helldiver operations around the Hive World Oshaune, it represents one of the most dangerous airborne Terminid organisms yet discovered. Protected by heavy armor, the Dragonroach circles high above the battlefield before diving toward its prey and unleashing sweeping attacks of combustible venom that ignite the ground. Its emergence demonstrated that the Gloom was capable of producing entirely new forms of massive Terminid life.",
    "source": "https://helldivers.wiki.gg/wiki/Dragonroach",
    "image": ""
  },
  "predator-strain": {
    "title": "Predator Strain",
    "category": "Terminid Strain",
    "description": "The Predator Strain is a Gloom-enhanced Terminid subfaction consisting of Predator Hunters and Predator Stalkers. First encountered during an attack on the Center of Science on Fenrir III in February 2185, these mutated Terminids displayed unusual discoloration, increased intelligence, and drastically altered hunting behavior. Predator units specialize in speed, flanking, ambush tactics, and concealment. Predator Hunters possess cloaking abilities, while Predator Stalkers sacrifice the traditional Stalker's cloak in favor of appearing in much greater numbers.",
    "source": "https://helldivers.wiki.gg/wiki/Predator_Strain",
    "image": ""
  },
   "spore-burst-strain": {
    "title": "Spore Burst Strain",
    "category": "Terminid Strain",
    "description": "The Spore Burst Strain is a Gloom-mutated Terminid subfaction first encountered during the First Gloom Expedition. The strain includes mutated Scavengers, Hunters, Warriors, and Bile Titans. Spore Burst Terminids are unusually fast and release explosive clouds of spores when killed. These clouds can damage Helldivers, obscure vision, and drive nearby Spore Burst Terminids into a frenzy that dramatically increases their speed. The strain was originally encountered within the Gloom, demonstrating the extreme evolutionary effects of prolonged exposure to the phenomenon.",
    "source": "https://helldivers.wiki.gg/wiki/Spore_Burst_Strain",
    "image": ""
  },
  "impaler": {
    "title": "Impaler",
    "category": "Terminid",
    "description": "The Impaler is a massive Terminid strain recognizable by the enormous armored carapace surrounding its head. When attacking, an Impaler anchors itself to the ground and deploys long subterranean tentacles that erupt beneath distant targets, allowing it to threaten Helldivers without directly approaching them. Impalers were encountered during the First Galactic War and were believed to have been driven to extinction. They later reappeared during the Second Galactic War, demonstrating the Terminids' ability to restore previously lost strains.",
    "source": "https://helldivers.wiki.gg/wiki/Impaler",
    "image": ""
  },
   "alpha-commander": {
    "title": "Alpha Commander",
    "category": "Terminid",
    "description": "The Alpha Commander is a heavier and more durable variant of the Brood Commander. Hyperevolved as a result of the Gloom, it possesses powerful claws and an aggressive charging attack. Unlike ordinary Brood Commanders, Alpha Commanders summon groups of Alpha Warriors, faster and deadlier variants of standard Terminid Warriors. They are encountered on the highest combat difficulties and can continue summoning reinforcements even after suffering severe injuries.",
    "source": "https://helldivers.wiki.gg/wiki/Alpha_Commander",
    "image": ""
  },
  "charger": {
    "title": "Charger",
    "category": "Terminid",
    "description": "The Charger is a large and heavily armored Terminid specialized in high-speed frontal attacks. Its thick exoskeleton protects most of its body while allowing it to charge directly through Helldiver formations, trampling soldiers and smashing through obstacles. Chargers are among the Terminids' most recognizable heavy assault organisms and have produced several specialized variants during the Second Galactic War.",
    "source": "https://helldivers.wiki.gg/wiki/Charger",
    "image": ""
  },
  "charger-behemoth": {
    "title": "Charger Behemoth",
    "category": "Terminid",
    "description": "The Charger Behemoth is a more heavily armored and durable variant of the standard Charger. Originally encountered in limited circumstances, Behemoths later became a regular battlefield threat during the Second Galactic War. They retain the devastating charging behavior of ordinary Chargers but possess greater resilience, making them a particularly dangerous heavy Terminid on high-intensity battlefields.",
    "source": "https://helldivers.wiki.gg/wiki/Charger_Behemoth",
    "image": ""
  },
  "spore-charger": {
    "title": "Spore Charger",
    "category": "Terminid",
    "description": "The Spore Charger is a mutated Charger variant surrounded by a dense cloud of Terminid spores. The moving cloud dramatically reduces visibility and can conceal the creature until it charges out of the fog toward its target. When killed, the Spore Charger violently explodes and releases corrosive material, making even its death dangerous to nearby Helldivers.",
    "source": "https://helldivers.wiki.gg/wiki/Spore_Charger",
    "image": ""
  },
  "bile-titan": {
    "title": "Bile Titan",
    "category": "Terminid",
    "description": "The Bile Titan is one of the largest and most dangerous Terminid organisms regularly encountered by Helldivers. Protected by heavy armor and supported by enormous legs capable of crushing infantry, the creature can also project streams of highly corrosive bile across the battlefield. A single Bile Titan is considered capable of destroying an entire SEAF platoon and generally requires dedicated anti-tank weaponry or heavy Stratagem support to eliminate.",
    "source": "https://helldivers.wiki.gg/wiki/Bile_Titan",
    "image": ""
  },
  "shrieker": {
    "title": "Shrieker",
    "category": "Terminid",
    "description": "Shriekers are flying Terminids specialized in rapid hit-and-run attacks. They first began appearing during the deployment of the Terminid Control System, with their numbers increasing following the activation of Termicide across the Barrier Planets. Shriekers emerge from specialized Shrieker Nests and attack by circling above Helldivers before diving at high speed with their razor-sharp limbs. Their sudden evolution became one of the early warning signs that Termicide was causing unexpected changes within the Terminid population.",
    "source": "https://helldivers.wiki.gg/wiki/Shrieker",
    "image": ""
  },
  "brood-commander": {
    "title": "Brood Commander",
    "category": "Terminid",
    "description": "The Brood Commander is a leadership-class Terminid responsible for coordinating attacks and reinforcing the swarm. Larger and more dangerous than ordinary Warriors, Brood Commanders can summon groups of Warriors and release pheromones capable of triggering Bug Breaches. Even after suffering fatal damage to the head, they can enter a berserk state and continue attacking until they bleed out.",
    "source": "https://helldivers.wiki.gg/wiki/Brood_Commander",
    "image": ""
  },
  "bile-spewer": {
    "title": "Bile Spewer",
    "category": "Terminid",
    "description": "The Bile Spewer is an armored Terminid developed from the Nursing Spewer and filled with enormous quantities of corrosive acid. It attacks Helldivers by projecting streams of bile capable of burning and slowing its targets. More developed Bile Spewers can also bombard distant positions with bile projectiles, giving the Terminid swarm a form of organic artillery support.",
    "source": "https://helldivers.wiki.gg/wiki/Bile_Spewer",
    "image": ""
  },
  "nursing-spewer": {
    "title": "Nursing Spewer",
    "category": "Terminid",
    "description": "The Nursing Spewer is a medium-sized Terminid capable of projecting corrosive digestive fluids over a wide area. Fluids once associated with feeding smaller Terminid strains have become dangerous biological weapons against Helldivers. Nursing Spewers also generate a thin cloud of spores around themselves that can obscure nearby smaller Terminids, providing the swarm with both ranged firepower and concealment.",
    "source": "https://helldivers.wiki.gg/wiki/Nursing_Spewer",
    "image": ""
  },
  "bile-warrior": {
    "title": "Bile Warrior",
    "category": "Terminid",
    "description": "The Bile Warrior is a mutated variant of the standard Terminid Warrior whose body is filled with corrosive bile. Its behavior closely resembles an ordinary Warrior, including its ability to summon Bug Breaches through pheromone signals. When killed through damage to its body, however, the creature can violently explode and spray damaging bile across nearby Helldivers and Terminids.",
    "source": "https://helldivers.wiki.gg/wiki/Bile_Warrior",
    "image": ""
  },
  "bile-spitter": {
    "title": "Bile Spitter",
    "category": "Terminid",
    "description": "The Bile Spitter is one of the smallest Terminid organisms but possesses a dangerous ranged attack. Exposure to toxic chemicals caused the creature to develop the ability to launch globules of corrosive bile at its enemies. Its acid can damage and slow Helldivers, while killing a Bile Spitter can cause its body to rupture in a small bile explosion capable of harming nearby targets.",
    "source": "https://helldivers.wiki.gg/wiki/Bile_Spitter",
    "image": ""
  }
}
